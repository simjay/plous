# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# env file
.env

# Python test and script caches
__pycache__/
*.pyc

# Local build outputs
/plous
/bin/
/dist/
/.cache/
.DS_Store
/docs-site/node_modules/
/docs-site/dist/
/docs-site/src/content/docs/
/docs-site/public/

# Dot-directories are local internals. GitHub Actions is the sole exception.
.*/
!/.github/
